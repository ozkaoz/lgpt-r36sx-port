# R36SX port: scripts must stay LF (shebang /bin/sh breaks with CRLF)
*.sh text eol=lf
*.c text eol=lf
*.h text eol=lf
*.cpp text eol=lf
*.xml text eol=lf
*.lgpt text eol=lf
*.md text eol=lf
*.txt text eol=lf
cubegm/lgpt text eol=lf
lgpt/otg/bin/* text eol=lf
*.ko binary
*.so binary
*.elf binary
*.png binary
*.jpg binary
*.wav binary
*.ttf binary
*.cpd binary
*.sln text eol=crlf
