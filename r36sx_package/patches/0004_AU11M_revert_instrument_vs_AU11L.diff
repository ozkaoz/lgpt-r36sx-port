-static void au11iColdModalStopOnlyBarrier(const char *reason) {
-    /* AU11L_FIRST_MODAL_STOP_ONLY_BARRIER
-       The remaining field crash is a cold first-use failure.  AU11H still touched
-       SamplePool/FileSystem during the first guarded press; if a project has a
-       stale or heavy sample list, that warm-up can itself hit the same crash path.
-       AU11L makes the first modal press non-destructive: stop transport/streaming,
-       yield, log, and return without touching sample pool, filesystem or modal constructors. */
-    Player *player = Player::GetInstance();
-    bool running = false;
-    bool streaming = false;
-    if (player) {
-        running = player->IsRunning();
-        streaming = player->IsStreaming();
-        if (running) player->Stop();
-        if (streaming) player->StopStreaming();
-    }
-    Trace::Log("AU11L", "FIRST_MODAL_STOP_ONLY_BARRIER %s running=%d streaming=%d",
-               reason ? reason : "modal", running ? 1 : 0, streaming ? 1 : 0);
-    TimeService::GetInstance()->Sleep(1200);
-}
