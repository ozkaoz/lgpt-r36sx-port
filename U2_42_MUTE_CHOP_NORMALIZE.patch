+int SampleChopperModal::snapFrameToZeroCrossing(int frame, int minFrame, int maxFrame) const {
+    if (!hasAssignedSample() || sampleIndex_ < 0 || sourceSize_ <= 1) return frame;
+    if (minFrame < 0) minFrame = 0;
+    if (maxFrame >= sourceSize_) maxFrame = sourceSize_ - 1;
+    if (maxFrame < minFrame) return frame;
+    frame = clampInt(frame, minFrame, maxFrame);
+
+    SoundSource *source = SamplePool::GetInstance() ? SamplePool::GetInstance()->GetSource(sampleIndex_) : 0;
+    if (!source) return frame;
+    int channels = source->GetChannelCount(-1);
+    short *samples = (short *)source->GetSampleBuffer(-1);
+    if (!samples || channels <= 0) return frame;
+
+    int search = sourceRate_ > 0 ? sourceRate_ / 400 : 110; /* about 2.5 ms at 44.1 kHz */
+    if (search < 24) search = 24;
+    if (search > 512) search = 512;
+
+    int best = frame;
+    int bestAbs = 0x7fffffff;
+    for (int d = 0; d <= search; d++) {
+        for (int side = 0; side < 2; side++) {
+            int f = frame + ((side == 0) ? -d : d);
+            if (f < minFrame || f > maxFrame) continue;
+            int prev = f > 0 ? f - 1 : f;
+            int v = 0;
+            int pv = 0;
+            for (int c = 0; c < channels; c++) {
+                v += samples[f * channels + c];
+                pv += samples[prev * channels + c];
+            }
+            int av = v < 0 ? -v : v;
+            bool crosses = (f == 0) || ((v <= 0 && pv >= 0) || (v >= 0 && pv <= 0));
+            if (crosses) return f;
+            if (av < bestAbs) { bestAbs = av; best = f; }
+        }
+    }
+    return best;
+}
