+void SampleChopperModal::nudgeChopReleaseMs(int deltaMs) {
+    int old = chopReleaseMs_;
+    chopReleaseMs_ = clampInt(chopReleaseMs_ + deltaMs, 0, 500);
+    if (chopReleaseMs_ != old) {
+        saveChopStateForCurrentSample();
+        char msg[64];
+        snprintf(msg, sizeof(msg), "Chop release %d ms", chopReleaseMs_);
+        setStatus(msg);
+    } else {
+        setStatus("Chop release limit");
+    }
+    isDirty_ = true;
+}
