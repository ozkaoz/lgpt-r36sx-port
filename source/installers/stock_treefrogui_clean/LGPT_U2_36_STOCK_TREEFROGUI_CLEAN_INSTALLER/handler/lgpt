#!/bin/sh
ROOT="/mnt/sdcard"
PICO="$ROOT/cubegm/picoarch"
CORE="$ROOT/cubegm/cores/lgpt_libretro.so"
ROM="$1"
LGPT_HOME="$ROOT/lgpt"
LOG="$LGPT_HOME/lgpt_launcher.log"

export HOME="$LGPT_HOME"
export ROOTFOLDER="$LGPT_HOME"
export SAMPLELIB="$LGPT_HOME/samples"
export INSTRUMENTFOLDER="$LGPT_HOME/instruments"
export LD_LIBRARY_PATH="$ROOT/cubegm/lib:$ROOT/cubegm/usr/lib:$LD_LIBRARY_PATH"

if [ "x$ROM" = "x" ]; then
  ROM="$ROOT/roms/lgpt/Start.lgpt"
fi

mkdir -p "$LGPT_HOME" "$LGPT_HOME/projects" "$LGPT_HOME/samples" "$LGPT_HOME/instruments" "$ROOT/roms/lgpt" "$ROOT/cubegm/cores"

{
  echo "============================================================"
  echo "LGPT U2.36 handler invoked"
  date
  echo "argv=$*"
  echo "PICO=$PICO"
  echo "CORE=$CORE"
  echo "ROM=$ROM"
  echo "ROOTFOLDER=$ROOTFOLDER"
  echo "SAMPLELIB=$SAMPLELIB"
  echo "INSTRUMENTFOLDER=$INSTRUMENTFOLDER"
  if [ ! -x "$PICO" ]; then echo "ERROR: picoarch is missing or not executable: $PICO"; fi
  if [ ! -f "$CORE" ]; then echo "ERROR: LGPT core is missing: $CORE"; fi
  if [ ! -f "$ROM" ]; then echo "WARN: ROM/launcher file not found: $ROM"; fi
} >> "$LOG" 2>&1

if [ ! -x "$PICO" ]; then
  exit 127
fi
if [ ! -f "$CORE" ]; then
  exit 126
fi

cd "$LGPT_HOME" || exit 1
exec "$PICO" "$CORE" "$ROM"
